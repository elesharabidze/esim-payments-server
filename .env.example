# Server
PORT=3000
# Public URL of the frontend, used to build the E-XEZINE return URLs
FRONTEND_URL=http://localhost:5174
# Public URL of this backend, used to build the E-XEZINE notification (webhook) URL
BACKEND_URL=http://localhost:3000

# Database
# Either set DATABASE_URL to a connection string - which is what hosted Postgres
# providers (Neon, Supabase, Vercel Postgres, Heroku) hand you, and what you want
# for a deployed environment - or set the five DB_* variables below.
# DATABASE_URL=postgres://user:password@host:5432/esim
#
# Discrete settings (match docker-compose.yml defaults, for local development).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=esim
DB_PASSWORD=esim
DB_NAME=esim

# TLS for the database connection. Defaults to true when DATABASE_URL is set and
# false otherwise, which is what local Postgres and managed Postgres respectively
# expect - override only if your setup differs.
# DB_SSL=true
# Set to true once you configure a CA that Node trusts for your provider.
# DB_SSL_REJECT_UNAUTHORIZED=false
# The schema is created from the entities on boot. Set to false if you would
# rather manage the schema yourself.
# DB_SYNCHRONIZE=true

# Payments
# "mock" simulates the E-XEZINE PSP entirely in-process (no network calls, no credentials needed) -
# useful for local development / demos when you don't have sandbox credentials yet.
# "exezine" calls the real E-XEZINE PSP Core API (https://docs.e-xezine.az).
# If left unset, it defaults to "exezine" when EXEZINE_SHOP_ID is set, otherwise "mock".
PAYMENT_PROVIDER=mock

# Required when PAYMENT_PROVIDER=exezine.
# Obtained from the E-XEZINE backoffice: Shops -> your shop -> Details -> Credential section.
EXEZINE_SHOP_ID=
EXEZINE_SECRET_KEY=
EXEZINE_CHECKOUT_BASE_URL=https://checkout.e-xezine.az
# RSA public key (PEM) from the backoffice, used to verify the "Content-Signature" header on webhooks.
EXEZINE_WEBHOOK_PUBLIC_KEY=
# Whether checkouts are created with "test": true (E-XEZINE test mode, no real money moves).
EXEZINE_TEST_MODE=true
